# ============================================================
# ENTERPRISE APPOINTMENT BACKEND — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
# ============================================================

# ----- SERVER CONFIGURATION -----
NODE_ENV=development
PORT=5000

# ----- FRONTEND URL (for CORS) -----
# For development: http://localhost:3000
# For production: https://yourdomain.com
FRONTEND_URL=http://localhost:5500

# ----- MONGODB DATABASE -----
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/database
# Local: mongodb://localhost:27017/enterprise_appointments
MONGODB_URI=mongodb://localhost:27017/enterprise_appointments

# ----- TWILIO WHATSAPP CONFIGURATION -----
# Get these from your Twilio Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# This is the Twilio sandbox number (starting with +1415...)

# ----- ADMIN WHATSAPP NUMBER -----
# The admin's WhatsApp number where notifications will be sent
# Include country code, e.g., +919876543210 (India) or +1234567890 (US)
ADMIN_WHATSAPP_TO=whatsapp:+919876543210

# ----- WHATSAPP MESSAGE TEMPLATE -----
# Use {placeholders} for dynamic content
WHATSAPP_TEMPLATE=📋 NEW APPOINTMENT REQUEST%0A%0A👤 Client: {fullName}%0A📞 Phone: {phone}%0A📧 Email: {email}%0A📍 Address: {address}%0A🛠️ Service: {service}%0A📅 Date: {appointmentDate}%0A⏰ Time: {appointmentTime}%0A📝 Notes: {notes}%0A%0A📅 Submitted: {submittedAt}%0A%0APlease follow up with the client to confirm.

# ----- ADDITIONAL SECURITY -----
# Rate limiting: max requests per IP per 15 minutes
RATE_LIMIT_MAX=50
RATE_LIMIT_WINDOW_MS=900000
